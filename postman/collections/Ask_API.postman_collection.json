          "protocol": "https",
          "host": [
            "api",
            "builtwith",
            "com"
          ],
          "path": [
            "ask1",
            "api.json"
          ],
          "query": [
            {
              "key": "KEY",
              "value": "{{KEY}}"
            },
            {
              "key": "QUERY",
              "value": "Magento websites in Spain"
            },
            {
              "key": "COMMIT",
              "value": "true"
            },
            {
              "key": "META",
              "value": "yes"
            }
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
