        "url": {
          "raw": "https://api.builtwith.com/ask1/api.json?KEY={{KEY}}&QUERY=Magento%20websites%20in%20Spain&COMMIT=true&NEXTOFFSET={{askNextOffset}}",
          "protocol": "https",
          "host": [
            "api",
